# ---------------------------------------------------------------------------
# E&J's CHICKENS — frontend environment
# Copy to `.env` (or `.env.local`) and adjust if your backend is not local.
# ---------------------------------------------------------------------------

# Base URL the browser uses to reach the API.
# Leave as /api/v1 to use the Vite dev-server proxy (recommended in development).
# In production set the full URL, e.g. https://api.ejchickens.com/api/v1
VITE_API_BASE_URL=/api/v1

# Where the Vite dev-server proxy forwards /api requests.
VITE_API_TARGET=http://127.0.0.1:8000
