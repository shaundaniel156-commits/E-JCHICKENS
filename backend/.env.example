# ---------------------------------------------------------------------------
# E&J's CHICKENS — backend environment
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Application
APP_NAME="E&J's CHICKENS"
APP_ENV=development            # development | production
DEBUG=true                     # set to false in production
API_V1_PREFIX=/api/v1

# Database
# For a quick look at the project, SQLite needs no server and no setup —
# this is what setup.bat / setup.sh configure automatically:
#   DATABASE_URL=sqlite:///./ejchickens.db
#
# For real use, MySQL is the supported database:
# format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://ejfarm:CHANGE_ME@localhost:3306/ej_chickens
DB_ECHO=false                  # true prints every SQL statement (debugging only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Security — generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# CORS — comma separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Farm defaults (can be changed later from the Settings page)
DEFAULT_CURRENCY=UGX
LOW_FEED_THRESHOLD_BAGS=5
HIGH_MORTALITY_RATE_PERCENT=5
BUDGET_WARNING_PERCENT=80
